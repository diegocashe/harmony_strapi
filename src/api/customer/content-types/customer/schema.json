{
  "kind": "collectionType",
  "collectionName": "customers",
  "info": {
    "singularName": "customer",
    "pluralName": "customers",
    "displayName": "Customer",
    "description": "Customer information"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "maxLength": 255,
      "required": true
    },
    "last_name": {
      "type": "string",
      "maxLength": 255
    },
    "ci": {
      "type": "string",
      "required": false,
      "unique": true
    },
    "email": {
      "type": "email",
      "unique": true
    },
    "phone": {
      "type": "string",
      "maxLength": 20
    },
    "registration_date": {
      "type": "datetime",
      "default": "2024-01-01T00:00:00.000Z"
    },
    "saved_addresses": {
      "type": "component",
      "component": "customer.address",
      "repeatable": true
    },
    "social_profiles": {
      "type": "component",
      "component": "customer.social-profile",
      "repeatable": true
    },
    "customer_sales": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::sale.sale",
      "mappedBy": "sale_customer"
    }
  }
}
