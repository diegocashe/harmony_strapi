{
  "kind": "collectionType",
  "collectionName": "product_variations",
  "info": {
    "singularName": "product-variation",
    "pluralName": "product-variations",
    "displayName": "Product Variation"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "sku": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "additional_variant_price": {
      "type": "integer",
      "required": true,
      "default": 0,
      "min": 0
    },
    "stock": {
      "type": "integer",
      "required": true,
      "default": 0,
      "min": 0
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "attributes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::attribute.attribute"
    },
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product",
      "inversedBy": "product_variations"
    }
  }
}
